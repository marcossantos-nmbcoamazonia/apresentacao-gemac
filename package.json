{
  "name": "apresentacao-copac",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "extract-assets": "node scripts/extract-assets.mjs",
    "conferir": "esbuild scripts/conferir-dados.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/conferir.mjs && node node_modules/.cache/conferir.mjs",
    "fontes": "node scripts/baixar-fontes.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
